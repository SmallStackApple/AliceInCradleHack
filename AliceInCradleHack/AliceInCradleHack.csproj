      <OutputDir>$(OutputPath)</OutputDir>
      <LibDir>$(OutputDir)lib\</LibDir>
    </PropertyGroup>
    <MakeDir Directories="$(LibDir)" Condition="!Exists('$(LibDir)')" />
    <ItemGroup>
      <NuGetDependenciesToMove Include="$(OutputDir)*.dll" Exclude="$(OutputDir)$(TargetFileName);&#xD;&#xA;                                         $(OutputDir)*.exe;&#xD;&#xA;                                         $(OutputDir)*.pdb;&#xD;&#xA;                                         $(OutputDir)*.xml;&#xD;&#xA;                                         @(Reference-&gt;WithMetadataValue('Private', 'False')-&gt;'%(CopyLocal=false)-&gt;'%(Filename).dll')" />
    </ItemGroup>
    <Move SourceFiles="@(NuGetDependenciesToMove)" DestinationFolder="$(LibDir)" OverwriteReadOnlyFiles="true" Condition="@(NuGetDependenciesToMove) != ''" />
  </Target>
