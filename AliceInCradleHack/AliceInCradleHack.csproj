  <Target Name="GenerateGitVersion" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <GeneratedFileDir>$(IntermediateOutputPath)Generated</GeneratedFileDir>
      <GeneratedFile>$(GeneratedFileDir)\GitVersion.cs</GeneratedFile>
    </PropertyGroup>
    <MakeDir Directories="$(GeneratedFileDir)" Condition="!Exists('$(GeneratedFileDir)')" />
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitHash" />
    </Exec>
    <PropertyGroup>
      <GitHash Condition="'$(GitHash)' == ''">unknown</GitHash>
      <GitHash>$([System.String]::Copy('$(GitHash)').Trim())</GitHash>
      <GitVersionContent>namespace AliceInCradleHack&#xD;&#xA;{&#xD;&#xA;    public static partial class Client&#xD;&#xA;    {&#xD;&#xA;        public const string GitHash = &quot;$(GitHash)&quot;%3B&#xD;&#xA;    }&#xD;&#xA;}</GitVersionContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(GeneratedFile)" Overwrite="true" Lines="$(GitVersionContent)" />
    <ItemGroup>
      <Compile Include="$(GeneratedFile)" />
    </ItemGroup>
  </Target>
  <Target Name="MoveNuGetDependenciesToLibFolder" AfterTargets="AfterBuild">
